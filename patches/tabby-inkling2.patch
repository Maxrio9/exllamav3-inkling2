@@ -0,0 +1,88 @@
+"""Incremental parser for Inkling's repeated typed model messages."""
+
+import re
+
+from endpoints.OAI.utils.stream_parser import CONTENT, REASONING, TOOL, _partial_token_len
+from endpoints.OAI.utils.toolcall_formats.inkling2 import (
+    END_MESSAGE,
+    END_SAMPLING,
+    INVOKE_TOOL,
+    MODEL_MESSAGE,
+    TEXT,
+    THINKING,
+)
+
+_CHANNELS = {THINKING: REASONING, TEXT: CONTENT, INVOKE_TOOL: TOOL}
+_TOKENS = [MODEL_MESSAGE, *_CHANNELS, END_MESSAGE, END_SAMPLING]
+_TOKEN_RE = re.compile("|".join(map(re.escape, _TOKENS)))
+_MAX_HOLD = max(map(len, _TOKENS)) - 1
+_TOKEN_FIRST = frozenset(token[0] for token in _TOKENS)
+
+
+class InklingStreamParser:
+    """Emit text as it arrives and each tool body once its message closes."""
+
+    def __init__(self, initial_channel: str | None = None):
+        self._channel = initial_channel
+        self._pending = ""
+        self._tool_parts: list[str] = []
+        self._ended = False
+        self.saw_tag = False
+
+    @property
+    def in_reasoning(self) -> bool:
+        return self._channel == REASONING
+
+    @property
+    def in_content(self) -> bool:
+        return self._channel == CONTENT
+
+    @property
+    def in_tool(self) -> bool:
+        return self._channel == TOOL
+
+    def _route(self, text: str, events: list[tuple[str, str]]):
+        if text and self.in_tool:
+            self._tool_parts.append(text)
+        elif text and self._channel is not None:
+            events.append((self._channel, text))
+
+    def _close(self, events: list[tuple[str, str]]):
+        if self.in_tool and self._tool_parts:
+            events.append((TOOL, "".join(self._tool_parts)))
+            self._tool_parts.clear()
+        self._channel = None
+
+    def feed(self, text: str) -> list[tuple[str, str]]:
+        self.saw_tag = False
+        self._pending += text
+        events = []
+        while self._pending and not self._ended:
+            match = _TOKEN_RE.search(self._pending)
+            if match is None:
+                hold = _partial_token_len(self._pending, _TOKENS, _TOKEN_FIRST, _MAX_HOLD)
+                emit = len(self._pending) - hold
+                self._route(self._pending[:emit], events)
+                self._pending = self._pending[emit:]
+                break
+
+            self.saw_tag = True
+            self._route(self._pending[: match.start()], events)
+            self._close(events)
+            self._pending = self._pending[match.end() :]
+            token = match[0]
+            self._channel = _CHANNELS.get(token)
+            self._ended = token == END_SAMPLING
+        if self._ended:
+            self._pending = ""
+        return events
+
+    def finish(self) -> list[tuple[str, str]]:
+        events = []
+        # Keep a trailing literal '<', but discard incomplete control tags.
+        if self._pending == "<":
+            self._route(self._pending, events)
+        self._pending = ""
+        self._close(events)
+        self._ended = True
+        return events
