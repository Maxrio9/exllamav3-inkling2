+"""Exercise the Tabby loader against the merged engine with CPU test stubs."""
+
+import asyncio
+import json
+import os
+import runpy
+import subprocess
+import sys
+from pathlib import Path
+from contextlib import ExitStack
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+TABBY = Path(__file__).resolve().parents[1]
+ENGINE = Path(os.environ.get("INKLING_ENGINE", TABBY.parent)).resolve()
+
+
+@pytest.mark.parametrize("dspark,skip_warmup", [(False, False), (True, False), (False, True)])
+def test_inkling_loader_uses_registered_model_and_single_device(tmp_path, dspark, skip_warmup):
+    assert (ENGINE / "tests/parity/inkling2_cpu_runner.py").is_file(), "Set INKLING_ENGINE to the merged checkout"
+    pythonpath = [str(ENGINE), str(TABBY), str(ENGINE / ".cpu-deps")]
+    if os.environ.get("PYTHONPATH"):
+        pythonpath.append(os.environ["PYTHONPATH"])
+    subprocess.run(
+        [sys.executable, __file__, str(tmp_path), str(int(dspark)), str(int(skip_warmup))],
+        check=True,
+        env={**os.environ, "PYTHONPATH": os.pathsep.join(pythonpath)},
+        timeout=30,
+    )
+
+
+async def verify_loader(release, dspark, skip_warmup):
+    from torch import _dynamo
+    runpy.run_path(ENGINE / "tests/parity/inkling2_cpu_runner.py")["install_test_stubs"]()
+
+    from safetensors.torch import save_file
+    from tokenizers import Tokenizer, models
+
+    from backends.exllamav3 import model as backend
+    from common.transformers_utils import HFModel
+    from endpoints.OAI.types.chat_completion import ChatCompletionRequest
+    from endpoints.OAI.utils.toolcall_formats.inkling2 import (
+        ARCHITECTURE,
+        DETECT,
+        END_MESSAGE,
+        END_SAMPLING,
+    )
+    from exllamav3.architecture.inkling2_loop import Inkling2LoopModel
+    from exllamav3.cache.fp16 import CacheLayer_fp16
+    from exllamav3.cache.quant import CacheLayer_quant
+
+    tokens = ["<unk>", *DETECT.special_tokens]
+    vocab = {token: i for i, token in enumerate(tokens)}
+    tokenizer = Tokenizer(models.WordLevel(vocab, unk_token="<unk>"))
+    tokenizer.add_special_tokens(tokens[1:])
+    tokenizer.save(str(release / "tokenizer.json"))
+    raw = {
+        "architectures": [ARCHITECTURE],
+        "eos_token_id": [vocab[END_MESSAGE], vocab[END_SAMPLING]],
+        "text_config": {
+            "num_hidden_layers": 1,
+            "hidden_size": 16,
+            "n_routed_experts": 2,
+            "num_attention_heads": 2,
+            "num_key_value_heads": 2,
+            "head_dim": 8,
+            "local_layer_ids": [],
+            "vocab_size": len(vocab),
+            "loop_config": {"core_start": 0, "core_end": 1, "num_passes": 2},
+        },
+    }
+    if dspark:
+        raw["mtp_config"] = dict(
+            hidden_size=16, num_hidden_layers=1, num_attention_heads=2, num_key_value_heads=1,
+            head_dim=8, intermediate_size=16, local_layer_ids=[], sliding_window_size=16,
+            block_size=8, markov_rank=4, target_layer_ids=[0, 2], rms_norm_eps=1e-6,
+            rope_theta=10000., max_position_embeddings=512, markov_head_type="rnn_hidden",
+        )
+        save_file({"fixture": backend.torch.zeros(1)}, release / "model-mtp.safetensors")
+    (release / "config.json").write_text(json.dumps(raw))
+    (release / "tokenizer_config.json").write_text(
+        json.dumps(
+            {
+                "added_tokens_decoder": {
+                    vocab[token]: {"content": token, "special": True} for token in tokens[1:]
+                },
+            }
+        )
+    )
+    (release / "quantization_config.json").write_text('{"bits":{}}')
+    template = TABBY / "tests/fixtures/inkling2.jinja"
+    (release / "chat_template.jinja").write_bytes(template.read_bytes())
+    hf_model = await HFModel.from_directory(release)
+
+    with pytest.raises(ValueError, match=r"supports cache_mode FP16 or Q8. Got Q4"):
+        await backend.ExllamaV3Container.create(release, hf_model, cache_mode="Q4")
+    with pytest.raises(FileNotFoundError, match=r"release file is missing: .*model.safetensors"):
+        await backend.ExllamaV3Container.create(release, hf_model)
+
+    save_file({"fixture": backend.torch.zeros(1)}, release / "model.safetensors")
+    with (
+        patch.object(backend.torch.cuda, "device_count", return_value=0),
+        patch.object(backend, "torch_gpu_problem", return_value=None),
+        patch.object(backend, "hardware_supports_exllamav3", return_value=True) as supports,
+    ):
+        if dspark:
+            with pytest.raises(ValueError, match="DSpark requires cache_mode FP16"):
+                await backend.ExllamaV3Container.create(
+                    release, hf_model, cache_mode="Q8", draft_model={"draft_mode": "mtp"}
+                )
+        container = await backend.ExllamaV3Container.create(
+            release, hf_model, max_batch_size=8, max_seq_len=256, cache_size=256,
+            cache_mode="FP16" if dspark else "Q8",
+            draft_model={"draft_mode": "mtp" if dspark else "disabled"},
+            **({"warmup": False} if skip_warmup else {}),
+        )
+    supports.assert_called_once_with([0])
+    assert isinstance(container.model, Inkling2LoopModel)
+    assert container.tool_format == "inkling2"
+    assert container.inkling_stop_token == vocab[END_SAMPLING]
+    assert container.tokenizer.get_id_to_piece_list(True)[vocab[END_MESSAGE]] == END_MESSAGE
+    assert container.cache_mode == ("FP16" if dspark else "Q8")
+    assert container.warmup_enabled is not skip_warmup
+    assert container.recurrent_checkpoint_interval_pp == container.chunk_size
+    assert container.max_batch_size == container.cache.num_slots == 1
+    assert len(container.cache.layers) == 2
+    cache_type = CacheLayer_fp16 if dspark else CacheLayer_quant
+    assert all(isinstance(layer, cache_type) for layer in container.cache.layers.values())
+    if not dspark:
+        assert all(layer.k_bits == layer.v_bits == 8 for layer in container.cache.layers.values())
+    assert not container.cache.initialized
+
+    load_gen = container.model.load_gen
+
+    def cpu_load_gen(*, device, **kwargs):
+        assert device == "cuda:0"
+        assert kwargs["max_batch_size"] == 1
+        assert not container.cache.initialized
+        yield from load_gen(device="cpu", **kwargs)
+
+    async def warm_before_ready():
+        assert container.cache.initialized and container.generator is not None
+        assert not container.loaded
+
+    with (
+        ExitStack() as stack,
+        patch.object(container, "warmup_inkling", AsyncMock(side_effect=warm_before_ready)) as warmup,
+        patch.object(container.model, "load_components"),
+        patch.object(container.model, "load_gen", side_effect=cpu_load_gen),
+    ):
+        if dspark:
+            # Replace the learned weights and CUDA pinned allocator only. Both
+            # models still load their real cache layers and build AsyncGenerator.
+            def cpu_components(device):
+                container.model.embedding = backend.torch.nn.Embedding(len(vocab), 16)
+                container.model.loop = backend.torch.nn.Identity()
+            stack.enter_context(patch.object(container.model, "load_components", side_effect=cpu_components))
+            stack.enter_context(patch.object(container.draft_model, "load_components"))
+            empty = backend.torch.empty
+            def cpu_empty(*args, **kwargs):
+                kwargs.pop("pin_memory", None)
+                return empty(*args, **kwargs)
+            stack.enter_context(patch.object(backend.torch, "empty", side_effect=cpu_empty))
+        expected_phases = 1 if skip_warmup else 2
+        assert [progress async for progress in container.load_gen()] == [(0, 1), (1, 1)] * expected_phases
+        assert warmup.await_count == expected_phases - 1
+    try:
