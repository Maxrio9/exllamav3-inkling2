+"""Inkling 2's JSON tool calls, one object per typed message."""
+
+import json
+
+from endpoints.OAI.types.tools import Tool, ToolCall
+from endpoints.OAI.utils.toolcall_formats.common import FormatSignature
+
+ARCHITECTURE = "Inkling2LoopForConditionalGeneration"
+MODEL_MESSAGE = "<|message_model|>"
+THINKING = "<|content_thinking|>"
+TEXT = "<|content_text|>"
+INVOKE_TOOL = "<|content_invoke_tool_json|>"
+END_MESSAGE = "<|end_message|>"
+END_SAMPLING = "<|content_model_end_sampling|>"
+
+TOOLCALL_START = None
+TOOLCALL_END = None
+DETECT = FormatSignature(
+    template_markers=(MODEL_MESSAGE, THINKING, INVOKE_TOOL, END_SAMPLING),
+    special_tokens=(MODEL_MESSAGE, THINKING, TEXT, INVOKE_TOOL, END_MESSAGE, END_SAMPLING),
+    architectures=(ARCHITECTURE,),
+    structured=True,
+)
+
+
+def parse_toolcalls(text: str) -> list[ToolCall]:
+    try:
+        body = json.loads(text)
+    except (ValueError, RecursionError):
+        return []
+
+    if not isinstance(body, dict):
+        return []
+    name = body.get("name")
+    arguments = body.get("args")
+    if not isinstance(name, str) or not name or not isinstance(arguments, dict):
+        return []
+    try:
+        arguments_json = json.dumps(arguments, ensure_ascii=True, allow_nan=False)
+    except ValueError:
+        return []
+    return [ToolCall(function=Tool(name=name, arguments=arguments_json))]
