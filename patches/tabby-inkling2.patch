+        # Intercept the job before enqueueing. Generation itself needs CUDA.
+        params = ChatCompletionRequest(
+            messages=[{"role": "user", "content": "hello"}],
+            temperature=0.6, top_k=20, stop=["user stop"], max_tokens=8,
+        )
+        with patch.object(backend, "AsyncJob", side_effect=RuntimeError("captured")) as make_job:
+            with pytest.raises(RuntimeError, match="captured"):
