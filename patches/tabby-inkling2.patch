+        assert container.generator.generator.cache is container.cache
+        assert container.generator.generator.max_batch_size == 1
+        assert container.generator.generator.pipeline is None
+        assert container.generator.generator.reuse_inkling_graphs
+        assert container.generator.generator.dspark_draft is dspark
+        if dspark:
+            assert container.draft_model.target is container.model
+            assert container.draft_cache.initialized
+            assert container.draft_cache.layers[(0, 0)].rows.shape[:2] == (1, 256)
+            assert container.generator.generator.num_draft_tokens == 7
