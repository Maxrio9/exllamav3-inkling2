+    assert "Thinking effort level: 0.2<|end_message|>" in prompt
+    assert "<|content_thinking|>Check Berlin.<|end_message|>" in prompt
+    assert (
+        "<|message_model|>weather<|content_invoke_tool_json|>"
+        '{"name":"weather","args":{"city":"Berlin"}}<|end_message|>'
+    ) in prompt
+    assert prompt.endswith("<|message_tool|>weather<|content_text|>sunny<|end_message|>")
+
+
+def tool_values(calls):
+    return [(call["function"]["name"], json.loads(call["function"]["arguments"])) for call in calls]
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_chat_completions_http(fake_model, stream):
+    async def request():
+        transport = httpx.ASGITransport(app=setup_app())
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            return await client.post("/v1/chat/completions", json={**REQUEST, "stream": stream})
+
+    response = asyncio.run(asyncio.wait_for(request(), timeout=5))
+    assert response.status_code == 200, response.text
+    if stream:
+        frames = [
+            line.removeprefix("data: ")
+            for line in response.text.splitlines()
+            if line.startswith("data: ")
+        ]
+        assert frames.pop() == "[DONE]"
+        choices = [json.loads(frame)["choices"][0] for frame in frames]
+        assert choices.pop()["finish_reason"] == "tool_calls"
+        deltas = [choice["delta"] for choice in choices]
+        assert deltas[0]["role"] == "assistant"
+        assert "".join(delta.get("reasoning_content", "") for delta in deltas) == (
+            "Check Berlin.Check Paris too."
+        )
+        assert "".join(delta.get("content", "") for delta in deltas) == "I’ll check both."
+        tool_frames = [i for i, delta in enumerate(deltas) if delta.get("tool_calls")]
+        second_thinking = next(
+            i
+            for i, delta in enumerate(deltas)
+            if delta.get("reasoning_content") == "Check Paris too."
+        )
+        answer = next(i for i, delta in enumerate(deltas) if delta.get("content"))
+        assert tool_frames[0] < second_thinking < tool_frames[1] < answer
+        calls = [call for delta in deltas for call in delta.get("tool_calls", [])]
+        assert [call["index"] for call in calls] == [0, 1]
+    else:
+        choice = response.json()["choices"][0]
+        assert choice["finish_reason"] == "tool_calls"
+        message = choice["message"]
+        assert message["reasoning_content"] == "Check Berlin.Check Paris too."
+        assert message["content"] == "I’ll check both."
+        calls = message["tool_calls"]
+
+    assert tool_values(calls) == EXPECTED_TOOLS
+    assert len({call["id"] for call in calls if call["id"].startswith("call_")}) == 2
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_chat_completions_cancels_waiting_generator_on_disconnect(fake_model, stream):
+    async def run():
+        parked = asyncio.Event()
+        disconnect = asyncio.Event()
+        tool_sent = asyncio.Event()
+        closed = asyncio.Event()
+        cleanup_calls = []
+        sent = []
+        request_body = json.dumps({**REQUEST, "stream": stream}).encode()
+
+        async def cancel_job():
+            await asyncio.sleep(0)
+            cleanup_calls.append("cancel")
+
+        async def stream_generate(
+            request_id, prompt, params, disconnect_handler, *_args, **_kwargs
+        ):
+            await disconnect_handler.add_cleanup_task(request_id, cancel_job, ())
+            try:
+                # Stop immediately after the first tool block has closed.
+                for text in REPLAY[:10]:
+                    yield {"text": text}
+                parked.set()
+                await asyncio.Event().wait()
+            finally:
+                await asyncio.sleep(0)
+                closed.set()
+
+        async def receive():
+            nonlocal request_body
+            if request_body:
+                body, request_body = request_body, b""
+                return {"type": "http.request", "body": body, "more_body": False}
+            await disconnect.wait()
+            return {"type": "http.disconnect"}
+
+        async def send(message):
+            sent.append(message)
+            if b'"tool_calls"' in message.get("body", b""):
+                tool_sent.set()
+
+        fake_model.stream_generate = stream_generate
+        app = setup_app()
+        scope = {
+            "type": "http",
+            "method": "POST",
+            "path": "/v1/chat/completions",
+            "query_string": b"",
+            "headers": [(b"content-type", b"application/json")],
+            "scheme": "http",
+            "client": ("127.0.0.1", 50000),
+            "server": ("test", 80),
+            "http_version": "1.1",
+            "asgi": {"spec_version": "2.4", "version": "3.0"},
+        }
+        request_task = asyncio.create_task(app(scope, receive, send))
+        try:
+            await asyncio.wait_for(parked.wait(), timeout=5)
+            if stream:
+                await asyncio.wait_for(tool_sent.wait(), timeout=5)
+            disconnect.set()
+            await asyncio.wait_for(request_task, timeout=5)
+        finally:
+            if not request_task.done():
+                request_task.cancel()
+                await asyncio.gather(request_task, return_exceptions=True)
+        assert closed.is_set()
+        assert cleanup_calls == ["cancel"]
+        assert all(b"[DONE]" not in message.get("body", b"") for message in sent)
+        assert sent[0]["status"] == (200 if stream else 422)
+
+    asyncio.run(run())
